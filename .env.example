# Frontend (Lovable Project Settings)
VITE_SUPABASE_URL=https://myygzczpldyovvqvbwbk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# External services (frontend calls)
VITE_DRAWINGS_UPLOAD_URL=https://your-server.com/api/drawings/upload
VITE_DRAWINGS_GENERATE_URL=https://your-server.com/api/drawings/generate-pack

# Server
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=https://your-app.lovable.dev,https://app.yourdomain.com
ALLOWED_ASSET_HOSTS=s3.amazonaws.com,storage.googleapis.com,myygzczpldyovvqvbwbk.supabase.co
MAX_UPLOAD_BYTES=26214400

# Supabase (for server & edge functions)
SUPABASE_URL=https://myygzczpldyovvqvbwbk.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Email (Postmark)
POSTMARK_API_KEY=your-postmark-api-key
FROM_EMAIL=notices@yourdomain.com

# API Keys
OPENAI_API_KEY=your-openai-key

# Stripe
STRIPE_API_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Security
LOVABLE_DOC_WEBHOOK_SECRET=your-webhook-secret

# Optional: Monitoring
SENTRY_DSN=your-sentry-dsn

# TSDR API (for trademark status sync)
TSDR_URL=https://your-edge-function-url/tm-tsdr
